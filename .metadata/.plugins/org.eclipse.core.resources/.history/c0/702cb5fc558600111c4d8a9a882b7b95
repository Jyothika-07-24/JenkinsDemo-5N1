package javabasics;

public class patternH {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int i,j,k,m=55;
		for(i=1;i<=m;i++) {
			for(j=1;j<=m;j++) {
				if((j==1 || j==m) && i!=((m/2)+1)) {
					System.out.print("*");
				}
				if((j>1 && j<m) && i!=((m/2)+1)) {
					System.out.print(" ");
				}
			}
			if(i==((m/2)+1)){
				for(k=1;k<=m/2;k++)
					System.out.print("* ");
			}
			System.out.println();
		}
	}

}
