package javabasics;

public class patternH {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int i,j,k;
		for(i=1;i<=5;i++) {
			for(j=1;j<=5;j++) {
				if((j==1 || j==5) && i!=((5/2)+1)) {
					System.out.print("*");
				}
				if((j>1 && j<5) && i!=((5/2)+1)) {
					System.out.print(" ");
				}
			}
			if(i==((5/2)+1)){
				for(k=1;k<=5;k++)
					System.out.print("*");
			}
			System.out.println();
		}
	}

}
